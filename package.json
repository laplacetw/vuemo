{
  "name": "vuemo-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./themes/*\" --filter \"./plugins/*\" build && pnpm -r --filter \"./examples/*\" build",
    "test": "pnpm -r test",
    "dev": "pnpm --filter blog dev",
    "release": "pnpm build && pnpm test && pnpm -r --filter '!create-vuemo' publish --tag alpha && pnpm --filter create-vuemo publish --tag alpha",
    "test:site": "pnpm --filter blog test:site",
    "test:contract": "pnpm --filter @vuemo/theme-default test:contract",
    "verify": "pnpm build && pnpm test && pnpm test:site && pnpm test:contract"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
