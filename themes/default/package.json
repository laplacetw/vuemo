{
  "name": "@vuemo/theme-default",
  "version": "0.1.0-alpha.3",
  "description": "Minimal default theme for Vuemo (Tailwind CSS)",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tailwindcss -i src/style.css -o dist/style.css --minify",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:contract": "node ../../packages/core/dist/cli.js check-theme ./src/index.ts"
  },
  "dependencies": {
    "minisearch": "^7.1.1"
  },
  "peerDependencies": {
    "@vuemo/core": "workspace:^",
    "vitepress": "^1.6.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@tailwindcss/typography": "^0.5.16",
    "@vuemo/core": "workspace:^",
    "tailwindcss": "^4.1.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.0.0",
    "vue": "^3.5.0"
  },
  "keywords": [
    "vuemo",
    "vitepress",
    "theme",
    "blog",
    "tailwindcss"
  ],
  "author": "Nick Liu",
  "homepage": "https://github.com/laplacetw/vuemo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laplacetw/vuemo.git",
    "directory": "themes/default"
  },
  "bugs": {
    "url": "https://github.com/laplacetw/vuemo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.3"
  }
}
