{
  "name": "@vuemo/core",
  "version": "0.1.0",
  "description": "Core of Vuemo: posts loader, composables, defineBlogConfig and the vuemo CLI",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vuemo": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./src/client/index.ts",
    "./posts.data": "./src/posts.data.ts",
    "./theme": "./src/theme.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vitepress": ">=1.6.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.3.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.0"
  },
  "keywords": [
    "vuemo",
    "vitepress",
    "blog",
    "markdown",
    "rss"
  ],
  "author": "Nick Liu",
  "homepage": "https://github.com/laplacetw/vuemo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laplacetw/vuemo.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/laplacetw/vuemo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
